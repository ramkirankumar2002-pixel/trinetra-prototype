{
  "name": "trinetra-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trinetra/web --filter @trinetra/server run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @trinetra/server run db:migrate",
    "db:seed": "pnpm --filter @trinetra/server run db:seed",
    "sim": "pnpm -C scripts run sim",
    "sim:plates": "pnpm -C scripts run sim:plates",
    "db:create": "pnpm --filter @trinetra/server run db:create",
    "db:generate": "pnpm --filter @trinetra/server run db:generate",
    "db:studio": "pnpm --filter @trinetra/server run db:studio",
    "test:coverage": "pnpm --filter @trinetra/shared run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
