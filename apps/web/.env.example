# Website settings. Copy this file to apps/web/.env.local and fill in the values.
# Never commit apps/web/.env.local.
# Everything starting with NEXT_PUBLIC_ is visible in the browser: no secrets here.

# Backend address for API calls, e.g. the Railway address. Used from Phase 6.
# Empty means http://localhost:4000 in development; a production build needs it.
NEXT_PUBLIC_API_URL=

# Backend address for live events (same server). Used from Phase 6. Same rule as above.
NEXT_PUBLIC_SOCKET_URL=
