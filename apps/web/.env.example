# Website settings. Copy this file to apps/web/.env.local and fill in the values.
# Never commit apps/web/.env.local.
# Everything starting with NEXT_PUBLIC_ is visible in the browser: no secrets here.

# Backend address that Next forwards /api/* to, e.g. the Railway address. Server side only.
# Read when Next starts, and for a production build when it is built (restart or rebuild
# after changing it). Empty means http://localhost:4000; a Vercel build needs it.
# Used from Phase 9.
BACKEND_URL=

# Backend address for live events: the browser connects to it directly (same server as
# BACKEND_URL). Used from Phase 6. Empty means http://localhost:4000 in development; a
# production build needs it.
NEXT_PUBLIC_SOCKET_URL=
