# Backend settings. Copy this file to apps/server/.env and fill in the values.
# Never commit apps/server/.env.
# Each comment says which phase first uses the variable.

# Postgres connection string. Used from Phase 2.
# The value is the local development database: PostgreSQL 16 on port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/trinetra

# Separate database for automated tests, which wipe it. The name must end in "_test".
# Used from Phase 2.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/trinetra_test

# Long random string used to sign login cookies. Used from Phase 3.
JWT_SECRET=

# Plate Recognizer API token for reading number plates. Used from Phase 7.
PLATE_RECOGNIZER_TOKEN=

# Google Gemini API key for invoice reading and the plate fallback. Used from Phase 7.
GEMINI_API_KEY=

# Where photos are stored. Set to "local" in development. Used from Phase 3.
STORAGE_DRIVER=

# Supabase project address (cloud photo storage). Storage code in Phase 3, set up in Phase 16.
SUPABASE_URL=

# Supabase service key. Secret: backend only. Storage code in Phase 3, set up in Phase 16.
SUPABASE_SERVICE_KEY=

# Supabase storage bucket for photos. Storage code in Phase 3, set up in Phase 16.
STORAGE_BUCKET=

# Secret the ESP32 sends to prove it is our weighbridge. Used from Phase 5.
DEVICE_TOKEN=

# Secret for the front ESP32-CAM. Used from Phase 5.
CAM_FRONT_TOKEN=

# Secret for the back ESP32-CAM. Used from Phase 5.
CAM_BACK_TOKEN=

# Website address allowed to call the API (CORS). Used from Phase 3.
FRONTEND_ORIGIN=

# Port the backend listens on. Empty means 4000. Used from Phase 1.
PORT=

# Server time zone; use Asia/Kolkata. Used from Phase 3.
TZ=
